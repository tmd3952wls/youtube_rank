# ==============================================================================
# youtube_rank — 완전 자동 효과음(SFX) 디렉터 & 쇼츠 파이프라인 환경변수 설정 (.env.example)
# 사용법: 이 파일을 프로젝트 루트에 `.env` 이름으로 복사한 뒤 실제 키와 경로를 입력하세요.
# ==============================================================================

# 1. 자동 효과음 디렉터 ON/OFF 마스터 스위치
# - true  : make_rank.py render 실행 시 초안 영상을 AI가 시청하고 자동으로 효과음 큐시트 생성·수급·합성
# - false : 기존 수동 plan.json 기반 쇼츠 렌더링 로직만 실행 (기존 동작 100% 유지)
AUTO_SFX_ENABLED=true

# 2. 로컬 효과음 라이브러리 경로 및 카탈로그 캐시 위치
LOCAL_SFX_DIR="C:\Users\tmd39\Desktop\효과음\효과음2869개"
# 미지정 시 기본값은 <LOCAL_SFX_DIR>/sfx_catalog.json 입니다.
# SFX_CATALOG_PATH="C:\Users\tmd39\Desktop\효과음\효과음2869개\sfx_catalog.json"

# 3. Google Gemini 멀티모달 API 설정 (오디오 청취 인덱싱 & 초안 영상 시청 큐시트 연출)
# 발급처: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# AQ. 로 시작하는 Vertex AI Express 키와 AI Studio 키를 자동 구분합니다 ("auto" | "true" | "false")
GEMINI_USE_VERTEXAI="auto"
GEMINI_AUDIO_MODEL="gemini-3.5-flash-lite"
GEMINI_VIDEO_MODEL="gemini-3.8-flash"
SFX_CATALOG_CHECKPOINT_EVERY=20

# 4. 하이브리드 효과음 수급 모드 및 외부 Fallback API 키 (선택)
# - auto       : 1순위 로컬 카탈로그 -> 2순위 Freesound(키 있을 때) -> 3순위 ElevenLabs(키 있을 때) 자동 전환
# - local_only : 외부 API 호출 없이 로컬 폴더(sfx_catalog.json)만 사용
# - freesound  : 로컬 미달 시 Freesound APIv2 만 사용
# - elevenlabs : 로컬 미달 시 ElevenLabs Sound Effects API 만 사용
SFX_FALLBACK_MODE="auto"
SFX_MATCH_THRESHOLD=0.45
SFX_LOCAL_SOFT_FLOOR=0.22

# [선택] 무료 효과음 검색·자동 다운로드 API (Freesound APIv2)
# 발급처: https://freesound.org/apiv2/apply/ (API Key 만 있어도 고음질 MP3/OGG 프리뷰 자동 다운로드 가능)
FREESOUND_API_KEY=""
# 원본 무손실 WAV 다운로드까지 원할 때만 OAuth2 Bearer 토큰 입력 (비워두어도 무방)
FREESOUND_OAUTH_TOKEN=""

# [선택] AI 텍스트-투-효과음 생성 API (ElevenLabs Sound Effects API)
# 문서: https://elevenlabs.io/docs/api-reference/text-to-sound-effects/convert
ELEVENLABS_API_KEY=""
ELEVENLABS_SFX_MODEL="eleven_text_to_sound_v2"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
ELEVENLABS_PROMPT_INFLUENCE=0.35

# 5. 오디오 볼륨 밸런싱(덕킹) 및 FFmpeg 마스터링 설정
# 나레이션/원본 대사 구간 대비 효과음 상대 레벨 범위 (단위: dB, 권장 -12 ~ -18)
SFX_DUCK_DB_MIN=-12.0
SFX_DUCK_DB_MAX=-18.0
# 대사가 없는 구간에서 단발성 효과음 기본 정점 목표 (dBFS)
SFX_IDLE_PEAK_DB=-8.5
# 지속형 효과음에 FFmpeg sidechaincompress 실시간 덕킹 추가 적용 여부
SFX_USE_SIDECHAIN=false
# 최종 마스터 출력 라우드니스 (유튜브 쇼츠 권장 -14 LUFS)
SFX_TARGET_LUFS=-14.0

# 6. 큐시트 밀도 가드레일
SFX_MAX_CUES_PER_CLIP=4
SFX_MIN_CUE_GAP_SEC=0.30
SFX_PRESERVE_MANUAL_FX=true

# 7. [기존 기능 호환] 네이버 메일 전송 설정 (send_mail.py 용, secrets.env 와도 호환)
NAVER_ID=""
NAVER_PW=""
MAIL_TO=""
